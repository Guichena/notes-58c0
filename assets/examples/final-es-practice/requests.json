        "body": "{\n  \"settings\": {\n    \"number_of_shards\": 1,\n    \"number_of_replicas\": 0,\n    \"refresh_interval\": \"1s\",\n    \"index.translog.durability\": \"request\",\n    \"analysis\": {\n      \"filter\": {\n        \"tech_synonyms\": {\n          \"type\": \"synonym_graph\",\n          \"synonyms\": [\"es, elasticsearch\", \"db, database\"]\n        }\n      },\n      \"analyzer\": {\n        \"cjk_mixed\": {\n          \"type\": \"custom\",\n          \"char_filter\": [\"html_strip\"],\n          \"tokenizer\": \"standard\",\n          \"filter\": [\"cjk_width\", \"lowercase\", \"cjk_bigram\"]\n        },\n        \"en_index\": {\n          \"type\": \"custom\",\n          \"tokenizer\": \"standard\",\n          \"filter\": [\"lowercase\"]\n        },\n        \"en_search\": {\n          \"type\": \"custom\",\n          \"tokenizer\": \"standard\",\n          \"filter\": [\"lowercase\", \"tech_synonyms\"]\n        }\n      }\n    }\n  },\n  \"mappings\": {\n    \"dynamic\": \"strict\",\n    \"_source\": {\"enabled\": true},\n    \"properties\": {\n      \"tenant_id\": {\"type\": \"keyword\"},\n      \"doc_id\": {\"type\": \"keyword\"},\n      \"title\": {\n        \"type\": \"text\",\n        \"analyzer\": \"cjk_mixed\",\n        \"search_analyzer\": \"cjk_mixed\",\n        \"fields\": {\"raw\": {\"type\": \"keyword\", \"ignore_above\": 256}}\n      },\n      \"body\": {\"type\": \"text\", \"analyzer\": \"cjk_mixed\", \"store\": true},\n      \"english\": {\n        \"type\": \"text\",\n        \"analyzer\": \"en_index\",\n        \"search_analyzer\": \"en_search\"\n      },\n      \"code_id\": {\"type\": \"keyword\"},\n      \"tags\": {\"type\": \"keyword\"},\n      \"price_cents\": {\"type\": \"long\", \"coerce\": false},\n      \"created_at\": {\"type\": \"date\", \"format\": \"strict_date_optional_time||epoch_millis\"},\n      \"location\": {\"type\": \"geo_point\"},\n      \"version\": {\"type\": \"long\", \"coerce\": false},\n      \"deleted\": {\"type\": \"boolean\"},\n      \"authors_object\": {\n        \"type\": \"object\",\n        \"properties\": {\"name\": {\"type\": \"keyword\"}, \"role\": {\"type\": \"keyword\"}}\n      },\n      \"authors_nested\": {\n        \"type\": \"nested\",\n        \"properties\": {\"name\": {\"type\": \"keyword\"}, \"role\": {\"type\": \"keyword\"}}\n      },\n      \"metadata\": {\"type\": \"object\", \"enabled\": false}\n    }\n  }\n}",
