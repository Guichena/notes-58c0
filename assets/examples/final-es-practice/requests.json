        "expect": "HTTP 409；version_conflict_engine_exception",
        "origin": "examples/own-es/fences/06-example-06.http#8"
      },
      {
        "method": "PUT",
        "path": "/interview_visibility_v1/_doc/1?version=10&version_type=external",
        "body": "{\"title\":\"search visibility\",\"version\":10,\"deleted\":false}",
        "id": "same-10",
        "expect": "HTTP 409；external 要求严格大于当前版本",
        "origin": "examples/own-es/fences/06-example-06.http#9"
      },
      {
        "method": "PUT",
        "path": "/interview_visibility_v1/_doc/1?version=11&version_type=external&refresh=true",
        "body": "{\"title\":\"\",\"version\":11,\"deleted\":true}",
        "id": "tombstone-11",
        "expect": "HTTP 200；_version=11；软墓碑仍是存活文档",
        "origin": "examples/own-es/fences/06-example-06.http#10"
      },
      {
        "method": "PUT",
        "path": "/interview_visibility_v1/_doc/1?version=10&version_type=external",
        "body": "{\"title\":\"late old snapshot\",\"version\":10,\"deleted\":false}",
        "id": "stale-after-tombstone",
        "expect": "HTTP 409；旧版本不能覆盖软墓碑",
        "origin": "examples/own-es/fences/06-example-06.http#11"
      },
      {
        "method": "GET",
        "path": "/interview_visibility_v1/_search",
        "body": "{\"query\":{\"bool\":{\"filter\":[{\"term\":{\"deleted\":false}}]}}}",
        "id": "hide-tombstone",
        "expect": "HTTP 200；0 命中；deleted=false 排除软墓碑",
        "origin": "examples/own-es/fences/06-example-06.http#12"
      },
      {
        "method": "PUT",
        "path": "/interview_visibility_v1/_settings",
        "body": "{\"index\":{\"refresh_interval\":\"1s\"}}",
        "id": "restore-refresh",
        "expect": "HTTP 200；acknowledged=true；之后才使用 wait_for",
        "origin": "examples/own-es/fences/06-example-06.http#13"
      },
      {
        "method": "POST",
        "path": "/interview_visibility_v1/_bulk?refresh=wait_for",
        "body": "{\"index\":{\"_id\":\"2\",\"version\":20,\"version_type\":\"external\"}}\n{\"title\":\"valid bulk item\",\"version\":20,\"deleted\":false}\n{\"index\":{\"_id\":\"3\",\"version\":20,\"version_type\":\"external\"}}\n{\"title\":\"invalid bulk item\",\"version\":\"not-a-long\",\"deleted\":false}",
        "id": "bulk-mixed",
        "expect": "HTTP 200；errors=true；items[0].index.status=201，items[1].index.status=400 且含解析错误；成功项不回滚",
        "origin": "examples/own-es/fences/06-example-06.http#14"
      },
      {
        "method": "GET",
        "path": "/interview_visibility_v1/_doc/2",
        "body": "",
        "id": "bulk-valid-get",
        "expect": "HTTP 200；found=true；_source.version=20",
        "origin": "examples/own-es/fences/06-example-06.http#15"
      },
      {
        "method": "POST",
        "path": "/interview_visibility_v1/_flush",
        "body": "",
        "id": "flush",
        "expect": "HTTP 200；_shards.failed=0；不从大小变化推断持久化全部边界",
        "origin": "examples/own-es/fences/06-example-06.http#16"
      },
      {
        "method": "GET",
        "path": "/interview_visibility_v1/_stats/docs,segments,translog,refresh,flush,merge",
        "body": "",
        "id": "stats",
        "expect": "HTTP 200；观察 docs/segments/translog/refresh/flush/merge；不硬编码计数",
        "origin": "examples/own-es/fences/06-example-06.http#17"
      },
      {
        "method": "PUT",
        "path": "/interview_visibility_v1/_doc/4?refresh=wait_for",
        "body": "{\"title\":\"editable document\",\"version\":1,\"deleted\":false}",
        "id": "occ-create",
        "expect": "HTTP 201；内部版本文档4，与 external 文档分开",
        "origin": "examples/own-es/fences/07-example-07.http#1"
      },
      {
        "method": "GET",
        "path": "/interview_visibility_v1/_doc/4",
        "body": "",
        "id": "occ-get",
        "expect": "HTTP 200；记录真实 _seq_no 与 _primary_term",
        "origin": "examples/own-es/fences/07-example-07.http#2"
      },
      {
        "method": "PUT",
        "path": "/interview_visibility_v1/_doc/4?if_seq_no=REPLACE_WITH_SEQ_NO&if_primary_term=REPLACE_WITH_PRIMARY_TERM&refresh=wait_for",
        "body": "{\"title\":\"edited after conditional read\",\"version\":21,\"deleted\":false}",
        "id": "occ-write",
        "expect": "HTTP 200；在无并发写入条件下更新成功；必须替换真实 GET 令牌",
        "origin": "examples/own-es/fences/08-example-08.http#1"
      },
      {
        "id": "occ-stale-retry",
        "method": "PUT",
        "path": "/interview_visibility_v1/_doc/4?if_seq_no=REPLACE_WITH_SEQ_NO&if_primary_term=REPLACE_WITH_PRIMARY_TERM&refresh=wait_for",
        "body": "{\n  \"title\": \"edited after conditional read\",\n  \"version\": 21,\n  \"deleted\": false\n}",
        "expect": "HTTP 409；第一次成功后，故意重复使用旧令牌，应冲突；不能删除条件重试"
      },
      {
        "id": "bulk-invalid-absent",
        "method": "GET",
        "path": "/interview_visibility_v1/_doc/3",
        "body": "",
        "expect": "HTTP 404；found=false；失败 bulk item 没有写入"
      }
    ]
  }
