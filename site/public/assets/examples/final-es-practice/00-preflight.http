# Kibana Dev Tools Console syntax; Elasticsearch 8.15.3 isolated exercise only.
# Run one request at a time. Expected failures are deliberate. Never execute on production.

# version | HTTP 200；version.number 必须为 8.15.3，其他版本先核对接口，不把本清单当已验证
GET /

# absent-interview_docs_v1 | HTTP 404 才继续；200 表示已有索引/别名/数据流，401/403 或其他状态均停止
HEAD /interview_docs_v1?expand_wildcards=all

# absent-interview_java_demo | HTTP 404 才继续；200 表示已有索引/别名/数据流，401/403 或其他状态均停止
HEAD /interview_java_demo?expand_wildcards=all

# absent-interview_visibility_v1 | HTTP 404 才继续；200 表示已有索引/别名/数据流，401/403 或其他状态均停止
HEAD /interview_visibility_v1?expand_wildcards=all
