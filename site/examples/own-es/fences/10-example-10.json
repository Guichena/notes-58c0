{
  "size": 8,
  "_source": ["name"],
  "query": {
    "bool": {
      "filter": [
        { "term": { "tenant_id": "tenant_demo" } },
        { "term": { "active": true } }
      ],
      "must": [
        {
          "multi_match": {
            "query": "wireless mo",
            "type": "bool_prefix",
            "operator": "and",
            "fields": ["name", "name._2gram", "name._3gram"]
          }
        }
      ]
    }
  }
}
