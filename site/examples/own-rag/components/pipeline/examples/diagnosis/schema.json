{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DiagnosisDraft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "possible_causes",
    "recommended_checks",
    "fact_refs",
    "pending_confirmations",
    "insufficient_evidence"
  ],
  "properties": {
    "possible_causes": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "likelihood",
          "evidence"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "likelihood": {
            "enum": [
              "POSSIBLE",
              "MORE_LIKELY"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "uniqueItems": true,
            "minItems": 1,
            "maxItems": 8
          }
        }
      }
    },
    "recommended_checks": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "evidence"
        ],
        "properties": {
          "check_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "uniqueItems": true,
            "minItems": 1,
            "maxItems": 8
          }
        }
      }
    },
    "fact_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "uniqueItems": true,
      "minItems": 0,
      "maxItems": 32
    },
    "pending_confirmations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "uniqueItems": true,
      "minItems": 0,
      "maxItems": 16
    },
    "insufficient_evidence": {
      "type": "boolean"
    }
  }
}
