      "destinations": [
        {
          "stableReviewKey": "ai-模型与评测-7#1",
          "blockId": "visual-vlm-route",
          "ordinal": 3,
          "sha256": "cc1f0e8fa696bc38c5153f377719ab64361845f5e1acc11899155efd7bd9bacb"
