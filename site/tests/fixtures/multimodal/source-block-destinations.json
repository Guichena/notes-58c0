          "ordinal": 14,
          "sha256": "484d36f502d287b54ce76158d0443208987c326851194e9f5b459f8203fe6326"
        }
      ],
      "disposition": "retain-and-restructure",
      "uniqueInformation": "Text-only replay limits, minimum authorized recordings/events, timing/chunk/partial/final/interrupt/error preservation, deterministic substitute versus new real-model experiment retained.",
      "archiveDestination": null
    },
    {
      "sourceStableReviewKey": "ai-模型与评测-7#2",
      "sourceBlockId": "2:07",
