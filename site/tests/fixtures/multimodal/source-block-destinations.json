    {
      "sourceStableReviewKey": "ai-模型与评测-7#1",
      "sourceBlockId": "1:23",
      "sourceOrdinal": 23,
      "sourceTag": "details",
      "sourceRawHtml": "<details class=\"qa-variants\"><summary>其他问法（3）</summary><ul class=\"md-list\"><li>多模态业务与纯文本大模型业务的区别</li><li>多模态文档解析流程是怎样的？早融合、中融合、晚融合分别适合什么场景？</li><li>语音识别等 AI 服务后端架构有哪些优化思路？</li></ul></details>",
      "sourceSha256": "8525abd7e93822083fe157fc21f8940017188df5381fdcc8ea96e26574dbc1b8",
      "destinations": [
        {
