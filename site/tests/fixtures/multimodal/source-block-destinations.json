    {
      "sourceStableReviewKey": "ai-模型与评测-7#1",
      "sourceBlockId": "1:08",
      "sourceOrdinal": 8,
      "sourceTag": "h3",
      "sourceRawHtml": "<h3 class=\"md-h md-h3\">先确定输出是检索、理解、生成还是行动</h3>",
      "sourceSha256": "2460ccdbe9f76aeba6865acf685e5c16ab926d173f13614f56a94c5a1b031336",
      "destinations": [
        {
          "stableReviewKey": "ai-模型与评测-7#1",
          "blockId": "visual-task-heading",
          "ordinal": 17,
          "sha256": "5ce641cd5804c4f6e3d2d2ef189f2b66791f7a29a4968f80288f56ad2ddbaa47"
        }
      ],
      "disposition": "retain-and-restructure",
