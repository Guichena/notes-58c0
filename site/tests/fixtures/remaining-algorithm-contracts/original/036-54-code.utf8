import java.util.*; // 用 ArrayList 按访问顺序收集元素

class Solution {
    public List<Integer> spiralOrder(int[][] matrix) {
        List<Integer> answer = new ArrayList<>();
        int top = 0, bottom = matrix.length - 1;
        int left = 0, right = matrix[0].length - 1;

        while (top <= bottom && left <= right) {
            // 上边走完立刻 top++，下一层不再碰到这一行
            for (int c = left; c <= right; c++) answer.add(matrix[top][c]);
            top++;

            // 右边走完立刻 right--，已输出的列退出边界
            for (int r = top; r <= bottom; r++) answer.add(matrix[r][right]);
            right--;

            // 只剩一行时 top 已超过 bottom，不能再从右往左回头
            if (top <= bottom) {
                for (int c = right; c >= left; c--) answer.add(matrix[bottom][c]);
                bottom--;
            }

            // 只剩一列时 right 已小于 left，不能再从下往上回头
            if (left <= right) {
                for (int r = bottom; r >= top; r--) answer.add(matrix[r][left]);
                left++;
            }
        }
        return answer;
    }
}