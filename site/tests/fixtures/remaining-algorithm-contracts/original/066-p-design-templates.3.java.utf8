static class MyQueue {
    // in 收新元素，out 的栈顶是队头。每个元素最多从 in 倒进 out 一次，所以均摊 O(1)。
    // LC 225 改成两个队列：push 后把队里原有元素依次搬到新元素后面，使新元素留在队头。
    private final java.util.Deque<Integer> in = new java.util.ArrayDeque<>();
    private final java.util.Deque<Integer> out = new java.util.ArrayDeque<>();

    public void push(int x) { in.push(x); }

    public int pop() {
        pour();
        return out.pop();
    }

    public int peek() {
        pour();
        return out.peek();
    }

    public boolean empty() {
        return in.isEmpty() && out.isEmpty();
    }

    private void pour() {
        if (out.isEmpty()) {
            while (!in.isEmpty()) out.push(in.pop());
        }
    }
}

static class MinStack {
    // 辅助栈栈顶始终是数据栈当前最小值。相等也要压入，否则连续两个相同最小值会少记一次。
    private final java.util.Deque<Integer> data = new java.util.ArrayDeque<>();
    private final java.util.Deque<Integer> mins = new java.util.ArrayDeque<>();

    public void push(int val) {
        data.push(val);
        if (mins.isEmpty() || val <= mins.peek()) mins.push(val);
    }

    public void pop() {
        int val = data.pop();
        if (val == mins.peek()) mins.pop();
    }

    public int top() { return data.peek(); }

    public int getMin() { return mins.peek(); }
}