import java.util.*;

class Solution {
    public int compareVersion(String version1, String version2) {
        int i = 0;
        int j = 0;

        while (i < version1.length() || j < version2.length()) {
            long current1 = 0;
            long current2 = 0;

            // 按十进制累加，前导零被吸收；该侧已结束则这段保持 0。
            while (i < version1.length() && version1.charAt(i) != '.') {
                current1 = current1 * 10 + (version1.charAt(i) - '0');
                i++;
            }

            while (j < version2.length() && version2.charAt(j) != '.') {
                current2 = current2 * 10 + (version2.charAt(j) - '0');
                j++;
            }

            if (current1 < current2) {
                return -1;
            }
            if (current1 > current2) {
                return 1;
            }

            // 两段相等才越过点号；已到末尾时加 1 只是停在界外。
            i++;
            j++;
        }

        return 0;
    }
}