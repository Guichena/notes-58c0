import java.util.*; // 最后用 Arrays.fill 把需要清零的首行一次写完

class Solution {
    public void setZeroes(int[][] matrix) {
        int rows = matrix.length;
        int cols = matrix[0].length;

        // 首行首列马上要当标记用，先记住它们原本是否含 0
        boolean firstRowZero = false;
        boolean firstColZero = false;

        for (int c = 0; c < cols; c++) {
            if (matrix[0][c] == 0) firstRowZero = true;
        }
        for (int r = 0; r < rows; r++) {
            if (matrix[r][0] == 0) firstColZero = true;
        }

        // 内部的 0 只写进行首、列首，不必另开标记数组
        for (int r = 1; r < rows; r++) {
            for (int c = 1; c < cols; c++) {
                if (matrix[r][c] == 0) {
                    matrix[r][0] = 0;
                    matrix[0][c] = 0;
                }
            }
        }

        // 行首或列首为 0，说明这一行或这一列整段都要清
        for (int r = 1; r < rows; r++) {
            for (int c = 1; c < cols; c++) {
                if (matrix[r][0] == 0 || matrix[0][c] == 0) {
                    matrix[r][c] = 0;
                }
            }
        }

        if (firstRowZero) Arrays.fill(matrix[0], 0);
        if (firstColZero) {
            for (int r = 0; r < rows; r++) matrix[r][0] = 0;
        }
    }
}