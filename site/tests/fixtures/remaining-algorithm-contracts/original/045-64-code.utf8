import java.util.*; // Java 常用集合、队列、堆与数组工具

class Solution {
    public int minPathSum(int[][] grid) {
        int rows = grid.length;
        int cols = grid[0].length;

        // 原地覆盖：本格只依赖已更新的上、左，额外数组可以省掉。
        for (int r = 0; r < rows; r++) {
            for (int c = 0; c < cols; c++) {
                if (r == 0 && c == 0) continue;

                if (r == 0) {
                    // 第一行没有上方，只能接左边的最小和。
                    grid[r][c] += grid[r][c - 1];
                } else if (c == 0) {
                    // 第一列没有左方，只能接上边的最小和。
                    grid[r][c] += grid[r - 1][c];
                } else {
                    // 两条入边都合法时，取路径和更小的那条。
                    grid[r][c] += Math.min(grid[r - 1][c], grid[r][c - 1]);
                }
            }
        }

        return grid[rows - 1][cols - 1];
    }
}