class Solution {
    public int parseInt(String s) {
        int sign = 1;
        int index = 0;
        // 负号只看首位，数字从下一位开始累加
        if (s.charAt(0) == '-') {
            sign = -1;
            index++;
        }
        int ans = 0;
        while (index < s.length()) {
            char c = s.charAt(index++);
            // 非数字无法按十进制累加，直接拒绝
            if (c < '0' || c > '9') {
                throw new IllegalArgumentException("invalid number");
            }
            // 先乘 10 腾出个位，再加当前数位
            ans = ans * 10 + (c - '0');
        }
        return ans * sign;
    }
}