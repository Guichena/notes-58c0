class Solution {
    public int minDays(int[] bloomDay, int m, int k) {
        // 花不够凑成 m 束，不可能
        if ((long) m * k > bloomDay.length) {
            return -1;
        }
        int left = 1, right = 0;
        for (int day : bloomDay) {
            right = Math.max(right, day);
        }
        while (left < right) {
            int mid = left + (right - left) / 2;
            // 能做成就尝试更少天数，否则必须再等
            if (canMake(bloomDay, m, k, mid)) {
                right = mid;
            } else {
                left = mid + 1;
            }
        }
        return left;
    }

    private boolean canMake(int[] bloomDay, int m, int k, int limit) {
        int flowers = 0, bouquets = 0;
        for (int day : bloomDay) {
            if (day <= limit) {
                flowers++;
                // 相邻 k 朵才算一束，凑满后重新开始计数
                if (flowers == k) {
                    bouquets++;
                    flowers = 0;
                }
            } else {
                flowers = 0;
            }
        }
        return bouquets >= m;
    }
}