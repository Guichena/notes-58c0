import java.util.*; // 用哈希表按前缀和查历史次数

class Solution {
    public int subarraySum(int[] nums, int k) {
        // 只保存当前位置之前出现过的前缀和次数
        Map<Integer, Integer> frequency = new HashMap<>();
        frequency.put(0, 1); // 空前缀先记一次，从下标 0 开始的子数组才能被数到

        int prefix = 0;
        int answer = 0;

        for (int num : nums) {
            prefix += num;

            // 旧前缀等于 prefix-k 时，两段前缀之间的和正好是 k
            answer += frequency.getOrDefault(prefix - k, 0);

            // 查完再写入，当前前缀不能当作自己的历史端点
            frequency.put(prefix, frequency.getOrDefault(prefix, 0) + 1);
        }
        return answer;
    }
}