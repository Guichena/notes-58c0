import java.util.*; // Java 常用集合、队列、堆与数组工具

class MinStack {
    // 每帧存 [当前值, 入栈后的最小值]，弹出后上一帧的最小值仍在。
    private final Deque<int[]> stack = new ArrayDeque<>();

    public MinStack() {
    }

    public void push(int val) {
        int currentMin = stack.isEmpty()
                ? val
                : Math.min(val, stack.peek()[1]);
        stack.push(new int[]{val, currentMin});
    }

    public void pop() {
        stack.pop();
    }

    public int top() {
        return stack.peek()[0];
    }

    public int getMin() {
        // 最小值已写在栈顶帧的第二项，不用再扫描。
        return stack.peek()[1];
    }
}