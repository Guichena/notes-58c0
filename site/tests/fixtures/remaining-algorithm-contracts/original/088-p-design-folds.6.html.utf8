<p class="md-p">路径表示前缀，结束标记表示完整单词；有路径但没有结束标记时，只能说明前缀存在。</p><p class="md-p">考点：Trie 树的插入、查找和前缀匹配。</p>
<p class="md-p">解法：</p>
<div class="md-list-wrap"><ul class="md-list md-depth-0"><li>每个节点有 26 个子节点和一个 isEnd 标记。</li><li>insert 沿路径创建节点。</li><li>search 和 startsWith 沿路径查找，search 要求终点 isEnd。</li></ul></div>
<section class="code-card md-code-card"><div class="code-toolbar"><div class="toolbar-left"><span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="file-label">图论总结.java</span></div><button class="copy-button md-copy" type="button">复制代码</button></div><div class="code-scroll"><pre class="md-pre" data-lang="java">import java.util.*;
public class Main {
    static class Trie {
        Trie[] children = new Trie[26];
        boolean isEnd;
        void insert(String word) {
            Trie node = this;
            for (char c : word.toCharArray()) {
                int idx = c - 'a';
                if (node.children[idx] == null) node.children[idx] = new Trie();
                node = node.children[idx];
            }
            node.isEnd = true;
        }
        boolean search(String word) {
            Trie node = this;
            for (char c : word.toCharArray()) {
                int idx = c - 'a';
                if (node.children[idx] == null) return false;
                node = node.children[idx];
            }
            return node.isEnd;
        }
        boolean startsWith(String prefix) {
            Trie node = this;
            for (char c : prefix.toCharArray()) {
                int idx = c - 'a';
                if (node.children[idx] == null) return false;
                node = node.children[idx];
            }
            return true;
        }
    }
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        Trie trie = new Trie();
        for (int i = 0; i &lt; n; i++) {
            String op = sc.next();
            String word = sc.next();
            if (op.equals(&quot;insert&quot;)) trie.insert(word);
            else if (op.equals(&quot;search&quot;)) System.out.println(trie.search(word));
            else if (op.equals(&quot;startsWith&quot;)) System.out.println(trie.startsWith(word));
        }
    }
}</pre></div></section>