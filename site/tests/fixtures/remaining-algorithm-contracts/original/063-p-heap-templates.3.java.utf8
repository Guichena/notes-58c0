static int[] insertionSort(int[] a) {
    for (int i = 1; i < a.length; i++) {
        int x = a[i];
        int j = i - 1;
        // 已排序区间是 [0, i)。用 > 而不是 >=，相等元素保持原顺序
        while (j >= 0 && a[j] > x) {
            a[j + 1] = a[j];
            j--;
        }
        a[j + 1] = x;
    }
    return a;
}

static int[] mergeSort(int[] a) {
    int[] aux = new int[a.length];
    mergeRange(a, aux, 0, a.length - 1);
    return a;
}

static void mergeRange(int[] a, int[] aux, int lo, int hi) {
    if (lo >= hi) return;
    int mid = lo + (hi - lo) / 2;
    mergeRange(a, aux, lo, mid);
    mergeRange(a, aux, mid + 1, hi);
    int i = lo, j = mid + 1, k = lo;
    while (i <= mid && j <= hi) {
        // <= ：左半相等元素先写回，排序稳定。统计逆序对时改成在取右半元素时累加 mid - i + 1
        if (a[i] <= a[j]) aux[k++] = a[i++];
        else aux[k++] = a[j++];
    }
    while (i <= mid) aux[k++] = a[i++];
    while (j <= hi) aux[k++] = a[j++];
    for (int t = lo; t <= hi; t++) a[t] = aux[t];
}

static int[] heapSort(int[] a) {
    int n = a.length;
    // 最后一个非叶节点是 n/2-1，自底向上下沉，建堆是 O(n)
    for (int i = n / 2 - 1; i >= 0; i--) siftDown(a, i, n);
    for (int end = n - 1; end > 0; end--) {
        int t = a[0];
        a[0] = a[end];
        a[end] = t;
        siftDown(a, 0, end);
    }
    return a;
}

// 大顶堆下沉。子节点 2*i+1、2*i+2；根与末尾的非相邻交换可颠倒等键记录，故通常不稳定
static void siftDown(int[] a, int i, int n) {
    while (true) {
        int best = i;
        int left = 2 * i + 1, right = 2 * i + 2;
        if (left < n && a[left] > a[best]) best = left;
        if (right < n && a[right] > a[best]) best = right;
        if (best == i) break;
        int t = a[i];
        a[i] = a[best];
        a[best] = t;
        i = best;
    }
}