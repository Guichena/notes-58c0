// 反转闭区间 [l, r]。l>=r 时直接返回，空区间不会越界。
static void reverseRange(int[] a, int l, int r) {
    while (l < r) {
        int t = a[l];
        a[l] = a[r];
        a[r] = t;
        l++;
        r--;
    }
}

// LC 189 右旋 k：整体反转，再反转前 k 个，再反转剩余部分。
// k 先规范到 [0, n)。Java 中负 k 取模仍为负，所以写成 (k % n + n) % n；左旋 k 等价于右旋 n-k。
// 换题：LC 48 先按主对角线转置，再对每一行调用 reverseRange(row, 0, n-1)，得到顺时针 90°。
static void rotate(int[] nums, int k) {
    int n = nums.length;
    if (n == 0) {
        return;
    }
    k = (k % n + n) % n;
    reverseRange(nums, 0, n - 1);
    reverseRange(nums, 0, k - 1);
    reverseRange(nums, k, n - 1);
}